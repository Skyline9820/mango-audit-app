{
    "name": "mango/slim-app",
    "description": "Starter de Slim Framework con Router, ORM (Eloquent) y Sesiones",
    "type": "project",
    "require": {
        "php": "^7.4",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "illuminate/database": "^8.83",
        "vlucas/phpdotenv": "^5.5",
        "php-di/php-di": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
